# Environment Configuration
ENVIRONMENT=development

# Server Settings
HOST=0.0.0.0
PORT=8000

# Replicate API (REQUIRED)
# Get your token from https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Storage Settings
OUTPUT_DIR=outputs
TEMP_DIR=temp

# Processing Settings
MAX_BATCH_SIZE=100
MAX_CONCURRENT_TRYON=10

# Timeout Settings (seconds)
SINGLE_TRYON_TIMEOUT=60
BATCH_TRYON_TIMEOUT=300

# Redis Settings (for future caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_ENABLED=false
CACHE_TTL=86400

# IDM-VTON Model Settings
DEFAULT_SEED=42
DEFAULT_STEPS=30

